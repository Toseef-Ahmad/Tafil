{
  "appId": "com.tafil.app",
  "productName": "Tafil",
  "artifactName": "${productName}-${version}-${platform}-${arch}.${ext}",
  "compression": "maximum",
  "asar": true,
  "asarUnpack": [
    "**/*.node",
    "**/node_modules/ps-tree/**/*"
  ],
  "icon": "logo.svg",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "main.js",
    "preload.js",
    "renderer.js",
    "index.html",
    "canvas.html",
    "dist/output.css",
    "dist/canvas-bundle.js",
    "dist/goal-markdown-editor-bundle.js",
    "node_modules/xterm/**/*",
    "node_modules/xterm-addon-fit/**/*",
    "node_modules/xterm-addon-web-links/**/*",
    "node_modules/monaco-editor/**/*",
    "utils/**/*",
    "licensing/**/*",
    "assets/**/*",
    "!**/*.map",
    "!**/*.md",
    "!.git",
    "!.vscode",
    "!.cursor",
    "!node_modules/.cache",
    "!**/*.log",
    "!**/.DS_Store",
    "!**/test/**",
    "!**/__tests__/**"
  ],
  "extraResources": [
    {
      "from": "assets/",
      "to": "assets/",
      "filter": ["**/*"]
    }
  ],
  "mac": {
    "category": "public.app-category.developer-tools",
    "icon": "logo.svg",
    "darkModeSupport": true,
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.plist",
    "minimumSystemVersion": "10.13.0",
    "target": [
      {
        "target": "dmg",
        "arch": ["universal"]
      }
    ],
    "extendInfo": {
      "NSAppleEventsUsageDescription": "TAFIL needs to control other apps to open terminals and IDEs for your projects.",
      "NSSystemAdministrationUsageDescription": "TAFIL manages your development projects and requires access to project folders.",
      "CFBundleDocumentTypes": []
    },
    "type": "distribution"
  },
  "dmg": {
    "contents": [
      {
        "x": 130,
        "y": 220
      },
      {
        "x": 410,
        "y": 220,
        "type": "link",
        "path": "/Applications"
      }
    ],
    "window": {
      "width": 540,
      "height": 400
    },
    "title": "${productName} ${version}",
    "icon": "logo.svg",
    "backgroundColor": "#1a1a1a"
  },
  "win": {
    "icon": "logo.svg",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "requestedExecutionLevel": "asInvoker",
    "publisherName": "Touseef Ahmad",
    "verifyUpdateCodeSignature": false
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "allowElevation": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Tafil",
    "installerIcon": "logo.svg",
    "uninstallerIcon": "logo.svg",
    "installerHeaderIcon": "logo.svg",
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": true,
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "displayLanguageSelector": false,
    "installerLanguages": ["en_US"],
    "language": "1033",
    "multiLanguageInstaller": false
  },
  "portable": {
    "artifactName": "${productName}-${version}-portable.${ext}"
  },
  "linux": {
    "icon": "logo.svg",
    "category": "Development",
    "maintainer": "Touseef Ahmad <ahmadtouseef946@gmail.com>",
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      },
      {
        "target": "deb",
        "arch": ["x64"]
      },
      {
        "target": "rpm",
        "arch": ["x64"]
      }
    ],
    "desktop": {
      "Name": "Tafil",
      "Comment": "Project Command Center for Node.js Developers",
      "Categories": "Development;IDE;Utility;",
      "Terminal": "false",
      "StartupNotify": "true"
    },
    "executableName": "tafil"
  },
  "appImage": {
    "artifactName": "${productName}-${version}.${ext}",
    "license": "LICENSE"
  },
  "deb": {
    "depends": [
      "libnotify4",
      "libxtst6",
      "libnss3",
      "libsecret-1-0"
    ],
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "priority": "optional"
  },
  "rpm": {
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "fpm": ["--rpm-os=linux"]
  },
  "npmRebuild": true,
  "buildDependenciesFromSource": false,
  "nodeGypRebuild": false,
  "publish": null
}

